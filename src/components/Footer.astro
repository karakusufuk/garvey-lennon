---
import Logo from './Logo.astro';
import { SITE, LEGAL_LINES, DEMO_LINES } from '../data/site';
import { AREA_ORDER, AREAS } from '../data/areas';
const tel = 'tel:+353' + SITE.phone.replace(/\s/g, '').replace(/^0/, '');
---
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <Logo monogram={false} />
        <p class="addr">{SITE.address}<br><a href={tel}>{SITE.phone}</a><span class="sep"> · </span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div><h4>Services</h4><div class="fl">{AREA_ORDER.map(a => <a href={AREAS[a].slug}>{AREAS[a].title}</a>)}</div></div>
      <div><h4>The firm</h4><div class="fl"><a href="/about/">About</a><a href="/fees/">Fees</a><a href="/careers/">Careers</a><a href="/contact/">Contact</a></div></div>
      <div><h4>Read</h4><div class="fl"><a href="/insights/">Insights</a><a href="/legal/">Privacy and cookies</a><a href="/legal/#terms">Legal notice</a></div></div>
    </div>
    <div class="legalines">
      {LEGAL_LINES.map(l => <p>{l}</p>)}
    </div>
    <div class="demolines">
      {DEMO_LINES.map(l => <p>{l}</p>)}
    </div>
  </div>
</footer>
