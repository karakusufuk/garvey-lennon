---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
---
<Base title="Page not found">
  <div class="band b-light nf"><div class="wrap">
    <h1 class="ph1">That page <em>isn't here.</em></h1>
    <p class="sub">The address may have changed, or the link was mistyped. The four services and the question flow are one click away.</p>
    <div class="btns"><a class="btn" href="/">Back to the homepage</a><a class="btn soft" href="/contact/">Contact</a></div>
  </div></div>
</Base>
