---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { SITE } from '../data/site';
---
<Base title="Careers" description="Work with us: trainee solicitor and legal secretary roles at Garvey Lennon.">
  <div class="band b-light"><div class="wrap">
    <h1 class="ph1">Work with us.</h1>
    <p class="sub">Five people. Everyone here works directly with clients, trainees included.</p>
    <div class="roles">
      <div class="rolecard"><div><h2>Trainee solicitor, September 2027</h2><p>One place for a candidate who has passed the FE-1 exams and holds a place on the Professional Practice Course. Closes 31 January 2027.</p></div><button class="btn" data-copy={SITE.careersEmail} data-modal="careers">Copy application email</button></div>
      <div class="rolecard"><div><h2>Legal secretary, family law</h2><p>Court diaries, affidavits and client calls with Siobhan Garvey. Two years in a solicitors' office needed.</p></div><button class="btn" data-copy={SITE.careersEmail} data-modal="careers">Copy application email</button></div>
    </div>
  </div></div>
</Base>
